{
  "name": "@mi8y/cds-langgraph-plugins",
  "description": "SAP CDS LangGraph Plugins",
  "author": "Merbin J Anselm <merbin.j.anselm@mi8y.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mi8y/cds-langgraph-plugins.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/mi8y/cds-langgraph-plugins",
  "bugs": {
    "url": "https://github.com/mi8y/cds-langgraph-plugins/issues"
  },
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run --coverage",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "clean": "turbo run clean && rm -rf node_modules coverage .turbo",
    "format": "prettier --write \"**/*.{json,ts,js,mjs,cjs,md}\"",
    "format:check": "prettier --check \"**/*.{json,ts,js,mjs,cjs,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --no-frozen-lockfile && pnpm run format",
    "publish-packages": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "shx": "^0.4.0",
    "turbo": "^2.10.7",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
