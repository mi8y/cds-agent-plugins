{
  "name": "@mi8y/cds-agent-utils",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "dependencies": {},
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && npm run build:cds-types && vite build && npm run copy:cds-types",
    "build:cds-types": "node ../../scripts/build-cds-types.mjs",
    "copy:cds-types": "shx cp -r @cds-models dist",
    "test": "vitest run --coverage",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "clean": "shx rm -rf node_modules dist @cds-models tmp .turbo"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.40.0",
    "@cap-js/cds-types": "^0.18.0",
    "@eslint/js": "^10.0.1",
    "@sap/cds": ">=9",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "@sap/cds": ">=9"
  }
}
